# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=omni_user
DB_PASSWORD=omni_password
DB_NAME=omni_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=elastic

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=omni_rabbit
RABBITMQ_PASSWORD=omni_rabbit_pass

# n8n Credentials
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_change_me

# Backend Config - CHANGE IN PRODUCTION!
JWT_SECRET_KEY=your_super_secret_key_at_least_32_chars_long_change_me

# Mail (Gmail App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# GHN Config
GHN_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id

# VNPay Config
VNPAY_TMN_CODE=your_vnpay_tmncode
VNPAY_HASH_SECRET=your_vnpay_hashsecret

# n8n Webhook URL (internal docker network)
# Use http://omni_n8n:5678/webhook/omni-ai-chat when running inside Docker
# Use http://localhost:5678/webhook/omni-ai-chat for local development
OMNI_N8N_WEBHOOK_URL=http://localhost:5678/webhook/omni-ai-chat

# Frontend URLs
STOREFRONT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# Observability (Optional)
SENTRY_DSN=your_sentry_dsn_here
